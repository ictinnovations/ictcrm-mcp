# ICTCRM MCP server configuration. (ictcrm.com runs on the ICTContact backend.)
ICTCRM_BASE_URL=https://your-ictcrm
ICTCRM_USERNAME=admin
ICTCRM_PASSWORD=change-me

# Optional: unlock create/delete contact + add-to-campaign. Off by default.
# ICTCRM_MCP_ALLOW_WRITE=true

# Optional tuning.
# ICTCRM_TIMEOUT_MS=30000
# ICTCRM_TLS_INSECURE=false
